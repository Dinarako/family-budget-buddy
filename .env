# ── Database ─────────────────────────────────────────────────────────────────
# Get a free PostgreSQL URL from https://neon.tech  (sign up → New Project → copy connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=local-dev-secret-change-before-deploying

# ── Frontend ──────────────────────────────────────────────────────────────────
# Leave empty in development — Vite proxy routes /api/* to localhost:3001
# Set to your backend URL in production if not using Vercel serverless
VITE_API_URL=
