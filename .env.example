# ── Database ─────────────────────────────────────────────────────────────────
# Free PostgreSQL from https://neon.tech — sign up, create a project, copy the connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=3001

# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# ── Frontend ──────────────────────────────────────────────────────────────────
# Leave empty when running locally (Vite proxy handles /api/* → localhost:3001).
# When deploying the backend separately, set this to its full URL.
VITE_API_URL=
